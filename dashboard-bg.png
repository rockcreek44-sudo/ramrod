alse,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3332590463\":{\"name\":\"3332590463\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":3,\"id_type\":\"userID\",\"value\":{\"max_page_age_seconds\":1800},\"is_device_based\":false,\"passed\":false},\"1967546325\":{\"name\":\"1967546325\",\"rule_id\":\"2bcszlc7CFHdfdCdq7jXNb:0.00:6\",\"secondary_exposures\":[],\"version\":242,\"id_type\":\"workspace_id\",\"value\":{\"oversmokePercentage\":0,\"testCtor1Percentage\":0,\"loadTestPercentage\":0,\"showWorkspaceSettings\":false,\"gdrivePicker\":false,\"o365Picker\":false,\"o365Link\":false,\"o365BusinessLink\":false,\"o365Percentage\":0,\"o365PersonalLink\":false,\"gdriveLink\":false,\"testCtor1Link\":false,\"gdrivePercentage\":0,\"oversmokeLink\":false},\"is_device_based\":false,\"passed\":false},\"2214612631\":{\"name\":\"2214612631\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"trigger_words\":[\"messi\",\"soccer\",\"FIFA\",\"World Cup\"]},\"is_device_based\":false,\"passed\":false},\"1616547632\":{\"name\":\"1616547632\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"hidden_connector_ids\":[\"connector_openai_olympic\"]},\"is_device_based\":false,\"passed\":false},\"339548201\":{\"name\":\"339548201\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{\"log_every_ms\":10000,\"websocket_idle_timeout_ms\":180000,\"ignore_parent_id_mismatch\":false,\"log_every_n_events\":0},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"enable_web_search\":false,\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"user_prompt_key\":\"good_option\"},\"is_device_based\":false,\"passed\":false},\"1165494509\":{\"name\":\"1165494509\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":16,\"id_type\":\"userID\",\"value\":{\"loginStrategy\":\"existing_user\",\"tempDisabled\":false,\"enabled\":true,\"kind\":\"username\",\"name\":\"phone_number\"},\"is_device_based\":false,\"passed\":false},\"1104813507\":{\"name\":\"1104813507\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":20,\"id_type\":\"userID\",\"value\":{\"options\":[{\"key\":\"image_card_v1\",\"label\":\"ImageCardV1\"},{\"key\":\"image_card_v2_single\",\"label\":\"ImageCardV2: Single\"},{\"label\":\"ImageCar